    Check(r,scenes.SequenceEqual(new[]{HeartOfTheRain.App.Launch.LaunchPage.ScenePath,HeartOfTheRain.App.Launch.LaunchPage.GameScenePath}),"ApprovedSceneOrderRetained");
    string apk=Environment.GetEnvironmentVariable("HOTR_LTS116_APK");r.apk=Full(apk??"");
