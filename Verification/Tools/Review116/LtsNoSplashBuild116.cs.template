   Need(File.Exists(path)&&new FileInfo(path).Length<12*1024*1024,"BoundedLts116ReceiptRequired");
   var receipt=JsonUtility.FromJson<Receipt>(File.ReadAllText(path,new UTF8Encoding(false,true)));
