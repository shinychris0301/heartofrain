    Check(r,PlayerSettings.stripEngineCode&&UnityEditor.PackageManager.PackageInfo.GetAllRegisteredPackages().Any(p=>p.name=="com.unity.modules.tilemap"&&p.version=="1.0.0"),"ApprovedSpriteMaskDependencyRetained");
