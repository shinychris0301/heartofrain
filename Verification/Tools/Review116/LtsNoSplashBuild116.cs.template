   Need(File.Exists(Path.Combine(receipt.sourceRoot,"AGENTS.md"))&&Regex.IsMatch(receipt.nonce??"",@"\A[0-9a-f]{32}\z"),"OwnedLts116SourceRootRequired");
   Need(receipt.paths!=null&&receipt.sha256!=null&&receipt.paths.Length>2000&&receipt.paths.Length==receipt.sha256.Length,"CanonicalLts116PinsRequired");
   var seen=new HashSet<string>(StringComparer.OrdinalIgnoreCase);
   for(int i=0;i<receipt.paths.Length;i++){
    string relative=receipt.paths[i];Need(relative.StartsWith("Assets/",StringComparison.Ordinal)&&!relative.Contains("..")&&!relative.EndsWith(".meta",StringComparison.Ordinal)&&seen.Add(relative),"ContainedUniqueLts116AssetPinRequired");
