   }
   var actual=Directory.GetFiles(Application.dataPath,"*",SearchOption.AllDirectories).Where(p=>!p.EndsWith(".meta",StringComparison.Ordinal)).Select(p=>"Assets/"+p.Substring(Application.dataPath.Length+1).Replace('\\','/')).ToArray();
   Need(actual.Length==seen.Count&&actual.All(seen.Contains),"ExactLts116AssetSetRequired");
