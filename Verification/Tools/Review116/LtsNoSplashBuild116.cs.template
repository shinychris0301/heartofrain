   if(!string.IsNullOrEmpty(output)){Directory.CreateDirectory(output);using(var file=new FileStream(Path.Combine(output,"Build.json"),FileMode.CreateNew,FileAccess.Write))using(var writer=new StreamWriter(file,new UTF8Encoding(false)))writer.Write(JsonUtility.ToJson(r,true));}
   EditorApplication.Exit(r.status.StartsWith("PASS_",StringComparison.Ordinal)?0:1);
