   Need(!string.IsNullOrEmpty(path)&&Full(Path.GetDirectoryName(path))==Full(Directory.GetParent(Project).FullName),"Owned126ReceiptRequired");
   var receipt=JsonUtility.FromJson<Receipt>(File.ReadAllText(path,new UTF8Encoding(false,true)));
   Need(receipt!=null&&receipt.status=="PREPARED_MONETIZATION126"&&receipt.unity=="6000.3.27f1"&&receipt.packageName=="com.heartoftherain.game","Prepared126ReceiptRequired");
   Need(receipt.project!=null&&Full(receipt.project)==Project&&Project.StartsWith(Full("E:/.verification-cache/HOTR126")+Path.DirectorySeparatorChar,StringComparison.OrdinalIgnoreCase),"Owned126ProjectRequired");
   Need(File.Exists(Path.Combine(receipt.sourceRoot,"AGENTS.md"))&&Regex.IsMatch(receipt.nonce??"",@"\A[0-9a-f]{32}\z"),"Bound126SourceRootRequired");
   Need(receipt.paths!=null&&receipt.sha256!=null&&receipt.paths.Length>2000&&receipt.paths.Length==receipt.sha256.Length,"Complete126AssetPinsRequired");
   var seen=new HashSet<string>(StringComparer.OrdinalIgnoreCase);
   for(int i=0;i<receipt.paths.Length;i++){
    string p=receipt.paths[i];Need(p.StartsWith("Assets/",StringComparison.Ordinal)&&!p.Split('/').Any(v=>v==".."||v==""||v.Contains(":"))&&seen.Add(p),"Contained126SourceRequired");
    Need(File.Exists(p)&&Hash(p)==receipt.sha256[i],"Pinned126SourceChanged");
   }
   Need(receipt.metaPaths!=null&&receipt.metaGuids!=null&&receipt.metaPaths.Length==receipt.metaGuids.Length,"126GuidPinsRequired");
   for(int i=0;i<receipt.metaPaths.Length;i++){
